# Chat Routing Service — Postgres-backed engineer availability/queue router
# for the live-engineer-chat escalation feature. Called only by
# csm-portal/backend (see that backend's internal/routingclient and its own
# ROUTING_SERVICE_BASE_URL/ROUTING_SERVICE_TOKEN env vars, which must match
# this service's values below).

# Bare port number (not an address like ":9096").
ROUTING_SERVICE_PORT=9096

# Shared secret csm-portal/backend authenticates with (X-Routing-Service-Token
# header). Must equal that backend's own ROUTING_SERVICE_TOKEN. Generate one
# with: openssl rand -hex 24
ROUTING_SERVICE_TOKEN=

# How long (whole seconds) an engineer can sit PENDING -- assigned a case,
# not yet clicked Accept -- before POST /route/sweep-timeouts reassigns or
# requeues that case and takes the unresponsive engineer OFFLINE. See
# internal/router/timeout.go's SweepExpiredPending doc comment.
PENDING_TIMEOUT_SECONDS=90

# Point this at the SAME database entity-service uses (its own DB_HOST/
# DB_PORT/DB_NAME). This service's tables live in their own "chat_routing"
# Postgres schema inside that database (see internal/config.Schema and
# migrations/, which schema-qualifies every CREATE) rather than a separate
# database -- the two services' migration histories and table namespaces
# never collide even though they share one database. If DB_USER isn't a
# superuser/owner of that database, it needs GRANT USAGE, CREATE ON SCHEMA
# chat_routing (and ALL ON ALL TABLES/SEQUENCES once created) -- see the
# service README's "Running locally" section.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=disable
