# Shared OAuth2 client credentials — every upstream service client
# (customer entity, engineering entity, updates, SCIM) authenticates as this
# same app; only each service's base URL and scopes differ.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=

# Customer entity service
CUSTOMER_ENTITY_BASE_URL=
CUSTOMER_ENTITY_SCOPES=

# Engineering entity service (a separate internal service, not this repo's
# entity-service). Optional — not yet wired into cmd/server/main.go, no handler
# calls it — but uses the shared OAUTH2_* credentials above once it is.
# ENGINEERING_ENTITY_BASE_URL=
# ENGINEERING_ENTITY_SCOPES=

# Updates service
UPDATES_BASE_URL=
UPDATES_SCOPES=

# SCIM operations service
SCIM_BASE_URL=
SCIM_SCOPES=

# Dashboard widget registry. Optional — a JSON array of Dashboard objects
# (see internal/dashboard/widgets.go's Dashboard/WidgetTemplate json tags for
# the exact shape). Loaded once at process startup only: there is no
# file-watching, hot-reload, or admin endpoint — changing this value requires
# restarting the backend process. Left unset or malformed, GET /dashboards
# returns an empty list and GET /dashboards/{id} 404s for every id; startup
# and every other endpoint work normally (an error is logged, not a crash).
# Example (illustrative only — a real deployment's value is set directly in
# its own environment, not committed here, and is not required to resemble
# this shape beyond the schema):
# DASHBOARDS_CONFIG='[{"id":"sample-dashboard","displayName":"Sample Dashboard","isDefault":true,"targetTeam":"sample-team","widgets":[{"id":"my-open-cases","displayName":"My Open Cases","resourceType":"case","shape":"count","gridWidth":3,"filters":{"filters":[{"field":"assignedUserId","op":"in","values":["__current_user__"]},{"field":"state","op":"in","values":["open","work_in_progress"]}]}},{"id":"recent-cases","displayName":"Recent Cases","resourceType":"case","shape":"list","gridWidth":6,"listLimit":5,"filters":{"filters":[{"field":"tag","op":"in","values":["example-tag"]},{"field":"tag","op":"notIn","values":["excluded-example-tag"]}]}},{"id":"pending-time-cards","displayName":"Pending Time Cards","resourceType":"time_card","shape":"count","gridWidth":3,"filters":{"states":["pending"]}}]},{"id":"sample-team-dashboard","displayName":"Sample Team Dashboard","targetTeam":"sample-team","isTeamBased":true,"widgets":[{"id":"team-open-cases","displayName":"Team Open Cases","section":"Overview","resourceType":"case","shape":"count","gridWidth":4,"filters":{"filters":[{"field":"severity","op":"in","values":["critical","high"]},{"field":"state","op":"in","values":["open","work_in_progress"]}]}},{"id":"unassigned-cases","displayName":"Unassigned Cases","section":"Overview","resourceType":"case","shape":"count","gridWidth":4,"filters":{"filters":[{"field":"assignedUserId","op":"isEmpty"},{"field":"state","op":"in","values":["open"]}]}},{"id":"cases-by-severity","displayName":"Cases by Severity","description":"Share of active cases at each severity level.","resourceType":"case","shape":"pie","gridWidth":4,"filters":{"filters":[{"field":"state","op":"in","values":["open","work_in_progress"]}]},"slices":[{"label":"Critical","color":"error","filters":{"filters":[{"field":"severity","op":"in","values":["critical"]}]}},{"label":"Mine","filters":{"filters":[{"field":"assignedUserId","op":"in","values":["__current_user__"]}]}}]}]}]'

# Event Hub (Azure Event Hub's Kafka-compatible endpoint). Two independent
# things use this, both optional (left unset, neither runs — startup is
# unaffected either way):
#   - internal/caseevents' consumer — an independent consumer group that
#     reacts to case-events (logs today; see that package's doc comment for
#     what it'll grow into). Started in cmd/server/main.go whenever
#     EVENT_HUB_BROKER is set.
#   - internal/eventpublisher.Publisher — publishes domain events for
#     csm-notification-service to consume. Not yet wired into
#     cmd/server/main.go — no handler calls it yet, same status as
#     ENGINEERING_ENTITY_* above — but uses these same vars once it is.
# All-or-nothing: cmd/server/main.go uses EVENT_HUB_BROKER as the feature
# gate, then requires EVENT_HUB_CONNECTION_STRING and EVENT_HUB_TOPIC (fails
# startup if either is missing once EVENT_HUB_BROKER is set) — leave all
# three unset, or set all three together, never just one or two.
# EVENT_HUB_CONNECTION_STRING must be a namespace-level Shared Access Policy
# connection string (no EntityPath suffix) — an Event-Hub-scoped one will
# only authorize EVENT_HUB_TOPIC, not any other topic this backend might
# produce/consume later.
# EVENT_HUB_BROKER=
# EVENT_HUB_CONNECTION_STRING=
# EVENT_HUB_TOPIC=
# Consumer group ID internal/caseevents' consumer joins. Optional — defaults
# to "csm-portal-backend". Must be different from any other service's group
# consuming the same topic (e.g. csm-notification-service's own groups) —
# each distinct group gets its own full copy of every event.
# EVENT_HUB_CONSUMER_GROUP=

# Auth — set to false for local testing (skips JWT signature verification)
AUTH_JWKS_ENDPOINT=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_TOKEN_VALIDATOR_ENABLED=false

# Server
PORT=8080
# Comma-separated allow-list of browser Origins permitted to connect
# cross-origin to the main :8080 API. Fail-closed: unset denies every
# cross-origin browser request rather than allowing any (see middleware.CORS
# for why). In Choreo deployments the gateway supplies CORS instead, making
# this in-app version a no-op there — but leaving it unset is still a no-op,
# not an open door, so there's no harm setting it there too as
# defense-in-depth. For local dev, set it to wherever the webapp/microapp
# runs, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# Case-activity SSE stream listener (GET /cases/{id}/activities/stream).
# Only serves anything once EVENT_HUB_BROKER above is configured — otherwise
# it returns 503 for every connection attempt.
# STREAM_PORT=9092
# Comma-separated allow-list of browser Origins permitted to connect
# cross-origin. Fail-closed like CORS_ALLOWED_ORIGINS above — unset denies
# every cross-origin request; the main :8080 API's Choreo gateway supplies
# CORS on its own, but this listener's separately-declared endpoint isn't
# guaranteed to inherit that, see CLAUDE.md. For local dev:
# STREAM_CORS_ALLOWED_ORIGINS=http://localhost:3001

# Live-engineer-chat escalation feature (Novera chat "Talk to a live
# engineer" button). Two new always-on listeners, separate from the main
# :8083 API and the EVENT_HUB-gated STREAM_PORT above:
#   - CHAT_STREAM_PORT: SSE stream engineers subscribe to for live
#     escalation alerts (GET /chat/alerts/stream), same
#     authMiddleware chain as the main API. Always serves, no feature gate.
#   - INTERNAL_CHAT_PORT: service-to-service receiver for backend-v2's
#     escalate/customer-message calls, gated by INTERNAL_CHAT_TOKEN instead
#     of user auth (there is no customer JWT on these calls).
CHAT_STREAM_PORT=9094
INTERNAL_CHAT_PORT=9095
# Shared secret both backends must be configured with identically — see
# customer-portal/backend-v2's own INTERNAL_CHAT_TOKEN. Generate one with:
# openssl rand -hex 24
INTERNAL_CHAT_TOKEN=
# backend-v2's own internal listener (its main :8080/8082 WS listener — see
# that repo's CSM_PORTAL_INTERNAL_BASE_URL comment), used to push
# engineer_assigned/engineer_message/engineer_disconnected events into the
# customer's already-open chat WebSocket.
CUSTOMER_PORTAL_INTERNAL_BASE_URL=http://localhost:8082

# Engineer routing service (apps/chat-routing-service/backend) — the
# standalone prototype process that decides which available engineer (if
# any) an escalation is routed to, and tracks engineer Available/Busy/
# Offline presence (see internal/routingclient). If this service is
# unreachable, HandleEscalate falls back to broadcasting to every connected
# engineer instead of failing the customer's escalation.
ROUTING_SERVICE_BASE_URL=http://localhost:9096
# Shared secret this backend authenticates with (X-Routing-Service-Token
# header). Must equal that service's own ROUTING_SERVICE_TOKEN. Generate one
# with: openssl rand -hex 24
ROUTING_SERVICE_TOKEN=
