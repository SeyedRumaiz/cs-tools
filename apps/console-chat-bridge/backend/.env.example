# console-chat-bridge configuration.
#
# This service is a POC scoped to ONE known WSO2 IS instance -- see
# README.md and internal/introspect's own package doc comment for why.

# --- Browser-facing auth (identity-apps' Console -> this bridge) ---

# The known WSO2 IS instance this bridge trusts. Introspection endpoint is
# derived as {KNOWN_ISSUER_BASE_URL}/oauth2/introspect.
KNOWN_ISSUER_BASE_URL=https://localhost:9444

# Credentials for a small confidential "Standard-Based Application"
# registered once on that instance purely to call its introspection
# endpoint (HTTP Basic auth, RFC 7662) -- see README's setup steps. This is
# a technical credential, not a token subject: it authenticates BRIDGE ->
# IS for the introspect call itself, unrelated to whose token is being
# introspected.
INTROSPECTION_CLIENT_ID=
INTROSPECTION_CLIENT_SECRET=

# Origins allowed to call this bridge from a browser -- must be the exact
# origin identity-apps' Console is actually SERVED FROM (i.e. what shows up
# as the browser tab's URL / the request's Origin header), not
# KNOWN_ISSUER_BASE_URL above -- those are two different things and it's
# easy to copy the wrong one. In a typical local identity-apps dev setup
# that's the webpack dev server, e.g. https://localhost:9001, NOT the IS
# instance at :9444. Comma-separate multiple origins. Matched by exact
# string equality (see internal/middleware/cors.go) -- no trailing slash,
# no wildcard. Fail-closed: leaving this empty allows no browser through at
# all.
CORS_ALLOWED_ORIGINS=https://localhost:9001

# --- Outbound M2M (this bridge -> csm-portal/backend) ---

# csm-portal/backend's main API listener base URL.
CSM_PORTAL_BASE_URL=http://localhost:8080

# OAuth2 client-credentials grant against csm-portal/backend's own IdP
# application -- register a NEW client here carrying only the
# least-privilege "internal_console_chat_escalate" scope (see README),
# rather than reusing backend-v2's existing client/scopes.
CSM_PORTAL_TOKEN_URL=
CSM_PORTAL_CLIENT_ID=
CSM_PORTAL_CLIENT_SECRET=
CSM_PORTAL_SCOPES=internal_console_chat_escalate

# --- Inbound M2M (csm-portal/backend -> this bridge, POST /internal/chat-events) ---

# The OAuth2 client ID csm-portal/backend's own chatNotifiers["asgardeo"]
# entry (cmd/server/main.go) authenticates as when pushing events into this
# bridge -- must match CONSOLE_CHAT_BRIDGE_CLIENT_ID set on csm-portal/
# backend's own side. Checked by RequireClientID.
CSM_PORTAL_PUSH_CLIENT_ID=

PORT=8090
