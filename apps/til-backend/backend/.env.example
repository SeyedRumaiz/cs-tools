# Copy to .env and fill in before running locally.

# Required -- run sql/create_til_tables.sql against this database once
# before starting the app (db.py only ever verifies the table exists, it
# never creates it). No default for DB_PASSWORD: a missing value must fail
# loudly rather than silently connecting as root with an empty password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=til

ASGARDEO_JWKS_URL=https://api.asgardeo.io/t/<your-org>/oauth2/jwks
ASGARDEO_ISSUER=https://api.asgardeo.io/t/<your-org>/oauth2/token
TIL_MODERATOR_GROUP=<the Asgardeo group allowed to delete entries>

# Optional. Comma-separated Asgardeo client ids allowed to call this API
# (checked against the token's aud and client_id/azp claims). Absent =
# any token from the configured issuer is accepted regardless of which
# application it was issued to -- deliberately opt-in, since this API is
# meant to be called by more than one application.
ASGARDEO_ALLOWED_CLIENT_IDS=

# Required -- POST /submissions rejects every caller whose verified token
# identity (aud/client_id/azp) doesn't contain this value. The One WSO2
# webapp's own Asgardeo client id (a public SPA client id, not a secret --
# see that repo's public/config.js, ONE_WSO2_AUTH_CLIENT_ID). This is the
# ONLY entry point allowed to create a TIL entry. Checked against the
# caller's VERIFIED token, never a request header, since a header is
# caller-controlled and proves nothing about which application actually
# issued the token. Absent = nobody can submit (fails closed).
ONE_WSO2_WEBAPP_CLIENT_ID=

CORS_ALLOWED_ORIGIN=http://localhost:3000

# Optional. The claim key carrying the user's groups (default: "groups").
GROUPS_CLAIM=groups

# Optional. The One WSO2 webapp's own base URL (NOT this backend's) -- used
# only to build each entry's shareable link (.../knowledge-base/{id}) for
# the "View entry" button on the Chat card. Absent = no button, not an error.
ONE_WSO2_BASE_URL=

# Optional. Backs the "Customer name" autocomplete on the submission form
# (where == "Customer") via entity-service's POST /accounts/search -- see
# entity_client.py's own doc comment for the full config and the
# ENTITY_SERVICE_DEV_STATIC_TOKEN local-dev-only shortcut. Absent =
# search endpoint returns [], frontend falls back to free-text entry.
ENTITY_SERVICE_BASE_URL=
ENTITY_SERVICE_TOKEN_URL=
ENTITY_SERVICE_CLIENT_ID=
ENTITY_SERVICE_CLIENT_SECRET=

# Optional. Broadcasts every new submission into every connected user's own
# 1:1 DM with Novera (WSO2's internal Google Chat AI agent) -- the only
# notification channel this service has; there is no separate Chat Space
# webhook. NOVERA_NOTIFY_URL is Novera's own POST
# /internal/notifications/til-entry endpoint, gated by the Choreo API
# Gateway's own subscription auth (not an application-level secret) -- the
# three vars below fetch a client_credentials access token for an
# Application subscribed to Novera's API. Any one of these four absent =
# this is a no-op, not an error -- notify_novera never sends a request that
# would just fail at the gateway anyway.
NOVERA_NOTIFY_URL=
CHOREO_TOKEN_URL=
NOVERA_NOTIFY_CLIENT_ID=
NOVERA_NOTIFY_CLIENT_SECRET=
